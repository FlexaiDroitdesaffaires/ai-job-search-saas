NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Local integration only. Never enable this flag on a Cloud URL.
PILOT_ALLOW_LOCAL_SIGNUP=false
# Optional. Configure both values only after EasyJobs approves the partnership.
EASYJOBS_PARTNER_ID=
EASYJOBS_PARTNER_KEY=
